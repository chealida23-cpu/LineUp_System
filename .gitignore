# ==============================================================================
# LineUp System - Git Ignore Configuration
# ==============================================================================

# 1. Environment & Secret Credentials
.env
.env.*
!.env.example

# 2. Package Managers & Dependency Directories
node_modules/
target/

# 3. IDE & Editor Configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 4. Logs & Diagnostic Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Heavy Binaries & Executables
*.exe
cloudflared.exe

# 6. Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/

# 7. Local Database & State
*.db
*.sqlite3
!lineup.template.db

# 8. OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
